      }
    },
    "rukkysManager": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "The banner over the gate now says GOLDEN FLEECE II. You still open the bar at six. You still close at four. You get a salary on the 28th, like a bank worker, and you hate it in a very specific, bank-worker way."
        },
        {
          "type": "endChapter",
