        {
          "type": "goto",
          "scene": "professorJailed",
          "if": {
            "stats": {
              "policeHeat": ">= 50"
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "(sitting on the kerb, very tired) My son hates me. My hand has three fingers. My knees have no cartilage. {name}... what do I do now?"
        },
        {
          "type": "choice",
          "speaker": "professor",
          "text": "(For the first time, Professor is asking you for a rule.)",
          "options": [
            {
              "text": "Give him ₦50,000 to open a buka.",
              "cost": 50000,
              "requires": {
                "stats": {
                  "mentorBond": ">= 35"
                }
              },
              "showLocked": true,
              "lockedText": "Needs a strong bond with Professor (35)",
              "effects": {
                "goto": "professorBuka"
              }
            },
            {
              "text": "\"Go home to the village. Rest.\"",
              "effects": {
                "goto": "professorVillage"
              }
            },
            {
              "text": "\"Na you get rules. I no fit tell you.\"",
              "effects": {
                "changeStat": {
                  "mentorBond": -5
                },
                "goto": "professorStays"
              }
            }
          ]
        }
      ]
    },
    "professorDies": {
      "location": "underBridge",
      "time": "night",
      "beats": [
        {
          "type": "cutscene",
          "cards": [
            {
              "title": "The last rule",
              "text": "The Hyenas come back an hour later for revenge. Professor steps in front of you. He is very fast, for an old boxer. Not fast enough."
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "At the funeral, Giggles stands at the back, not laughing. Nobody at Iyana-Wahala calls out the stops that morning. The silence is the loudest thing the junction has ever done."
        },
        {
          "type": "setFlag",
          "flags": [
            "professor_dead"
          ]
        },
        {
          "type": "changeStat",
          "stats": {
            "communityGoodwill": -5,
            "rivalCultHatred": 10
          }
        },
        {
          "type": "endChapter",
          "title": "End of Act 3 — The Laugh",
          "summary": "Professor is gone. Some rules die with the man who made them.",
          "next": "ch10_election"
        }
      ]
    },
    "professorJailed": {
      "location": "frontStop",
      "time": "night",
      "positions": {
        "bassey": [
          -12,
          -6,
          180
        ],
        "professor": [
          -14,
          -6.5,
          0
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "bassey",
          "text": "Somebody must answer for the Under-Bridge wahala tonight. Na you, {name}. Your heat too high."
        },
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "No. Na me. (He holds out his wrists.) Old man, old crimes. Plenty paperwork. Take me."
        },
        {
          "type": "setFlag",
          "flags": [
            "professor_jailed"
          ]
        },
        {
          "type": "changeStat",
          "stats": {
            "policeHeat": -20,
            "mentorBond": 10
          }
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "The green van leaves with Professor in the back, waving with his three fingers like a man on a parade float."
        },
        {
          "type": "endChapter",
          "title": "End of Act 3 — The Laugh",
          "summary": "Professor took your fall. Police heat {stat:policeHeat}.",
          "next": "ch10_election"
        }
      ]
    },
    "professorBuka": {
      "location": "mamaPut",
      "time": "dusk",
      "beats": [
        {
          "type": "cutscene",
          "cards": [
            {
              "title": "Professor's Kitchen",
              "text": "Two weeks later, beside Mama Put, a new buka opens. The menu has twelve items. The rules of the road are painted on the wall. Rule number one is spelled wrong."
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "Customer number one: you. Free. Customer number two: also you, but you pay."
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "On opening day, a young man in a white shirt with no bandana buys one plate of rice and eats it slowly at the back table. He does not laugh. Professor gives him extra meat.",
          "if": "beatGiggles"
        },
        {
          "type": "setFlag",
          "flags": [
            "professor_buka"
          ]
        },
        {
          "type": "changeStat",
          "stats": {
