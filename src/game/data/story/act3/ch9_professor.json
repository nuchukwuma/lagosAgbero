            "communityGoodwill": 5
          }
        },
        {
          "type": "endChapter",
          "title": "End of Act 3 — The Laugh",
          "summary": "Professor's Kitchen is open. Bond with Professor {stat:mentorBond}.",
          "next": "ch10_election"
        }
      ]
    },
    "professorVillage": {
      "location": "frontStop",
      "time": "dawn",
      "positions": {
        "professor": [
          -14,
          -6.5,
          180
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "Village. Hm. Goats. Silence. My sister's cooking. (He laughs.) Okay. Okay. Somebody must teach the goats the rules of the road."
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "You put him on the 6 a.m. bus. Bíọ́dún refuses his fare. Professor pays anyway. Rule number one."
        },
        {
          "type": "setFlag",
          "flags": [
            "professor_village"
          ]
        },
        {
          "type": "changeStat",
          "stats": {
            "mentorBond": 8
          }
        },
        {
          "type": "endChapter",
          "title": "End of Act 3 — The Laugh",
          "summary": "Professor went home. You still can't.",
          "next": "ch10_election"
        }
      ]
    },
    "professorStays": {
      "location": "backSide",
      "time": "dawn",
      "positions": {
        "professor": [
          8,
          -6.2,
          200
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "Then I go stay. Back Side, same corner, same chair. Somebody must watch you."
        },
        {
          "type": "setFlag",
          "flags": [
            "professor_stays"
          ]
        },
        {
          "type": "endChapter",
          "title": "End of Act 3 — The Laugh",
          "summary": "Professor stays on the street. Bond with Professor {stat:mentorBond}.",
