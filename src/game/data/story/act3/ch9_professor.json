{
  "id": "ch9_professor",
  "act": 3,
  "number": 9,
  "title": "Chapter 9 — The Laugh",
  "description": "Sunday is a Hyena. The loyalty test. Professor's son. Professor's fate.",
  "startScene": "start",
  "scenes": {
    "start": {
      "location": "backSide",
      "time": "dawn",
      "positions": {
        "sunday": [
          5,
          -5,
          160
        ]
      },
      "beats": [
        {
          "type": "setFlag",
          "flags": [
            "dayLoop"
          ]
        },
        {
          "type": "cutscene",
          "cards": [
            {
              "title": "Day {stat:day}",
              "text": "Sunday is waiting at the Back Side. He is wearing a purple bandana. He is not dancing."
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "sunday",
          "text": "I be Hyena. Since before I meet you. Na dem give me the conductor job. Na dem dey collect half my money. I no fit comot."
        },
        {
          "type": "goto",
          "scene": "cultTest",
          "if": "cultPath"
        },
        {
          "type": "goto",
          "scene": "indieHelp"
        }
      ]
    },
    "cultTest": {
      "location": "backSide",
      "time": "day",
      "positions": {
        "chuks": [
          8,
          -6,
          200
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "chuks",
          "text": "(later) Number One Shell has a request. There is a Hyena inside Iyana-Wahala who passes our routes to Lord Laffy. We know it is your conductor friend. We need you to bring him to the Shell House tonight."
        },
        {
          "type": "choice",
          "speaker": "chuks",
          "text": "Loyalty is a file, brother. Today we open yours.",
          "options": [
            {
              "text": "Warn Sunday. Tell him to run tonight.",
              "effects": {
                "setFlag": "warnedSunday",
                "changeStat": {
                  "cultLoyalty": -10,
                  "friendBond": 3
                },
                "remember": {
                  "sunday": "warned"
                },
                "goto": "sundayRuns"
              }
            },
            {
              "text": "Pretend you couldn't find him.",
              "effects": {
                "setFlag": "sparedSunday",
                "changeStat": {
                  "cultLoyalty": -5
                },
                "remember": {
                  "sunday": "spared"
                },
                "goto": "sundaySpared"
              }
            },
            {
              "text": "Bring Sunday to the Shell House.",
              "effects": {
                "setFlag": [
                  "gaveUpSunday",
                  "lostSunday"
                ],
                "changeStat": {
                  "cultLoyalty": 15,
                  "cultRank": 1,
                  "rivalCultHatred": 15,
                  "mentorBond": -10,
                  "friendBond": -10
                },
                "remember": {
                  "sunday": "betrayed"
                },
                "goto": "sundayTaken"
              }
            }
          ]
        }
      ]
    },
    "sundayRuns": {
      "location": "backSide",
      "time": "night",
      "positions": {
        "sunday": [
          5,
          -5,
          160
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "sunday",
          "text": "You... you for don carry me go. (He hugs you, then he runs. At the corner, he dances. Just two steps.)"
        },
        {
          "type": "dialogue",
          "speaker": "chuks",
          "text": "(the next day) Strange. The Hyena vanished an hour before we came. Very strange. I have opened a file called 'Strange'.",
          "effects": {
            "setFlag": "chuksSuspicious"
          }
        },
        {
          "type": "goto",
          "scene": "son"
        }
      ]
    },
    "sundaySpared": {
      "location": "backSide",
      "time": "night",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "You tell Chuks you searched everywhere. You did not search anywhere. Sunday stays, quieter now, and pays you back the only way he can: he tells you everything the Hyenas plan."
        },
        {
          "type": "setFlag",
          "flag": "sundayInformant"
        },
        {
          "type": "goto",
          "scene": "son"
        }
      ]
    },
    "sundayTaken": {
      "location": "shellHouse",
      "time": "night",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Sunday does not fight. He just looks at you all the way into the Shell House. The door closes. Somebody inside starts to type."
        },
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "(the next morning) Sunday? ...I see. (He does not say anything else to you for the rest of the day.)"
        },
        {
          "type": "goto",
          "scene": "son"
        }
      ]
    },
    "indieHelp": {
      "location": "backSide",
      "time": "day",
      "positions": {
        "sunday": [
          5,
          -5,
          160
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "sunday",
          "text": "Lord Laffy say anybody wey wan comot must pay \"exit fee\" — ₦30,000 — or beat him for fair fight. Nobody don beat am. Abeg. Help me."
        },
        {
          "type": "choice",
          "speaker": "sunday",
          "text": "(He is shaking.)",
          "options": [
            {
              "text": "Pay Lord Laffy (₦30,000).",
              "cost": 30000,
              "effects": {
                "setFlag": "sundayFree",
                "changeStat": {
                  "friendBond": 2,
                  "communityGoodwill": 4
                },
                "remember": {
                  "sunday": "bought"
                },
                "goto": "sundayFreed"
              }
            },
            {
              "text": "Fight Lord Laffy for him.",
              "effects": {
                "startMode": "fight",
                "params": {
                  "opponent": "lordLaffy",
                  "difficulty": 2
                },
                "results": {
                  "won": {
                    "setFlag": [
                      "sundayFree",
                      "beatLordLaffy"
                    ],
                    "changeStat": {
                      "notoriety": 12,
                      "rivalCultHatred": 20
                    },
                    "goto": "sundayFreed"
                  },
                  "lost": {
                    "changeStat": {
                      "energy": -25,
                      "rivalCultHatred": 10
                    },
                    "goto": "sundayStuck"
                  }
                }
              }
            },
            {
              "text": "\"Sunday, I no fit. Sorry.\"",
              "effects": {
                "setFlag": "lostSunday",
                "changeStat": {
                  "communityGoodwill": -3
                },
                "remember": {
                  "sunday": "refused"
                },
                "goto": "sundayStuck"
              }
            }
          ]
        }
      ]
    },
    "sundayFreed": {
      "location": "backSide",
      "time": "dusk",
      "positions": {
        "sunday": [
          5,
          -5,
          160
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "sunday",
          "text": "(he throws the purple bandana into the gutter and dances on top of it) FREEDOM! Co-op go get new conductor! The best one! Me!"
        },
        {
          "type": "goto",
          "scene": "son"
        }
      ]
    },
    "sundayStuck": {
      "location": "backSide",
      "time": "dusk",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Sunday goes back to Under-Bridge. The laughter takes him in. He waves at you once from the far side of the road, and then he doesn't."
        },
        {
          "type": "setFlag",
          "flag": "lostSunday"
        },
        {
          "type": "goto",
          "scene": "son"
        }
      ]
    },
    "son": {
      "location": "underBridge",
      "time": "night",
      "positions": {
        "giggles": [
          0,
          -13,
          180
        ],
        "professor": [
          2,
          -15.5,
          0
        ]
      },
      "beats": [
        {
          "type": "cutscene",
          "cards": [
            {
              "title": "Under-Bridge",
              "text": "The Hyenas come for you at night. Their leader laughs a laugh you have heard before: in a hospital, through a swollen lip."
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "giggles",
          "text": "So you be Daddy's new son. The one wey him dey teach rules. Rule number one: never count money in front of... HA HA HA. I know all the rules. I learn dem first."
        },
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "Kúnlé. (Everyone stops.) Kúnlé, go home."
        },
        {
          "type": "dialogue",
          "speaker": "giggles",
          "text": "Home? Which home? The one you left to go fight for money? HA. HA."
        },
        {
          "type": "startMode",
          "mode": "fight",
          "params": {
            "opponent": "giggles",
            "difficulty": 2
          },
          "results": {
            "won": {
              "setFlag": "beatGiggles",
              "changeStat": {
                "notoriety": 6,
                "rivalCultHatred": 10
              },
              "goto": "fate"
            },
            "lost": {
              "setFlag": "lostToGiggles",
              "changeStat": {
                "energy": -20
              },
              "goto": "fate"
            }
          }
        }
      ]
    },
    "fate": {
      "location": "underBridge",
      "time": "night",
      "positions": {
        "professor": [
          2,
          -15.5,
          0
        ]
      },
      "beats": [
        {
