            {
              "text": "\"Somto. My dad knows your mum. Oil committees.\"",
              "effects": {
                "changeStat": {
                  "tamaraBond": 3,
                  "cover": 4
                },
                "remember": {
                  "tamaraFirst": "lied"
                }
