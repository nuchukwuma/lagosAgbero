    "tamara": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "tamara",
          "text": "You're the only person here who reads the prices on the drinks menu. (She hands you a bottle of water.) It's free. Everything here is free if you don't ask."
        },
        {
          "type": "choice",
          "speaker": "tamara",
          "text": "\"Tamara. Ademola-Peters. Yes, that Ademola-Peters. Don't make it weird.\"",
          "options": [
            {
              "text": "\"Somto. I read prices because I like knowing what things cost.\"",
