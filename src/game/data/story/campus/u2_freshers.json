    "mamaAtGate": {
      "beats": [
        {
          "type": "setFlag",
          "flags": [
            "mamaSomtoAround"
          ]
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Mama came. She's holding a cooler of akara 'for your new friends'. Behind you, a silver jeep stops. Tobi Lawal-Coker climbs out with two phones and a laugh."
        },
        {
          "type": "dialogue",
          "speaker": "tobi",
          "text": "Bro! Is that... akara? (He takes three.) Mad. Who's this?"
        },
        {
          "type": "choice",
          "speaker": "player",
          "text": "(Mama is smiling at Tobi like he's her own son.)",
          "options": [
            {
              "text": "\"This is my mother. She makes the best akara in Lagos.\"",
              "effects": {
                "setFlag": "ownedMama",
                "changeStat": {
                  "momBond": 15,
                  "cover": -25,
                  "campusRep": 4,
                  "conscience": 6
                }
              }
            },
            {
              "text": "\"She's... our cook. She insisted on coming.\"",
              "effects": {
                "setFlag": "deniedMama",
                "changeStat": {
                  "momBond": -25,
                  "conscience": -15,
                  "cover": 5
                }
              }
            },
            {
              "text": "\"Mama, please. Go home. I'll call you.\"",
              "effects": {
                "setFlag": "sentMamaAway",
                "changeStat": {
                  "momBond": -10,
                  "conscience": -4
                }
              }
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "mamaSomto",
          "text": "(quietly, folding the cooler's cloth very neatly) Okay, my son. Okay. Eat well. (She walks to the bus stop without looking back. She doesn't need to. You'll see her walk away for years.)",
          "if": "deniedMama"
        },
        {
          "type": "dialogue",
          "speaker": "tobi",
          "text": "Your mum's a legend. I'm coming for more akara. (He means it. He'll come every week.)",
          "if": "ownedMama"
        },
        {
          "type": "goto",
          "scene": "hostel"
        }
      ],
      "location": "gate",
