{
  "id": "events",
  "act": 0,
  "common": true,
  "title": "Street life",
  "description": "Small story moments that random events cut to. Each returns to the street.",
  "startScene": "sickChild",
  "scenes": {
    "sickChild": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "passenger",
          "text": "Abeg, abeg! My pikin dey hot like fire since morning. The chemist want ₦500 for drug. I no get am. Anybody?"
        },
        {
          "type": "choice",
          "text": "A woman holds a feverish child at the bus stop.",
          "options": [
            {
              "text": "Give her ₦500",
              "cost": 500,
              "effects": {
                "changeStat": {
                  "communityGoodwill": 4
                },
                "setFlag": "helpedChild",
                "noticedBy": [
                  "The street"
                ]
              }
            },
            {
              "text": "Carry them to Nurse Rónkẹ́ yourself",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 6,
                  "energy": -10
                },
                "setFlag": [
                  "helpedChild",
                  "tookChildToNurse"
                ]
              }
            },
            {
              "text": "\"Madam, me sef never chop.\"",
              "effects": {
                "changeStat": {
                  "communityGoodwill": -1
                }
              }
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "passenger",
          "text": "God go bless you! You no be like other agbero!",
          "if": "helpedChild"
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "stranded": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "passenger",
          "text": "My son, which bus dey go Ikorodu? Since 7 o'clock I dey here. Everybody dey shout \"Oshodi! Oshodi!\" I no wan go Oshodi!"
        },
        {
          "type": "choice",
          "text": "An old woman with a tray of pepper is lost.",
          "options": [
            {
              "text": "Put her on the right danfo, no charge",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 3
                },
                "setFlag": "helpedMamaPepper"
              }
            },
            {
              "text": "\"Consultation fee na ₦200, Mama.\"",
              "effects": {
                "changeStat": {
                  "money": 200,
                  "notoriety": 1,
                  "communityGoodwill": -2
                }
              }
            },
            {
              "text": "\"Ask that man.\" (point at nobody)",
              "effects": {
                "changeStat": {
                  "communityGoodwill": -1,
                  "notoriety": 1
                }
              }
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "passenger",
          "text": "Thank you! Take this pepper. E go burn your enemies. And your mouth.",
          "if": "helpedMamaPepper"
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "streetFight": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Two conductors are fighting over one passenger. The passenger has already left in a keke."
        },
        {
          "type": "choice",
          "text": "A crowd gathers. Somebody is taking bets.",
          "options": [
            {
              "text": "Break am up",
              "effects": {
                "startMode": "fight",
                "params": {
                  "opponent": "conductor",
                  "difficulty": 1
                },
                "results": {
                  "won": {
                    "changeStat": {
                      "notoriety": 3,
                      "communityGoodwill": 2
                    },
                    "setFlag": "brokeUpFight"
                  },
                  "lost": {
                    "changeStat": {
                      "energy": -15,
                      "notoriety": 1
                    }
                  }
                }
              }
            },
            {
              "text": "Bet ₦500 on the bigger one",
              "cost": 500,
              "effects": {
                "setFlag": "betOnFight"
              }
            },
            {
              "text": "Walk away. Na their wahala.",
              "effects": {
                "changeStat": {
                  "energy": 2
                },
                "toast": "You keep walking. Behind you, somebody loses a tooth and somebody wins ₦500."
              }
            }
          ]
        },
        {
          "type": "randomEvent",
          "if": "betOnFight",
          "outcomes": [
            {
              "weight": 1,
              "effects": {
                "changeStat": {
                  "money": 1000
                },
                "toast": "The bigger one wins! +₦1,000. The smaller one says it was a draw."
              }
            },
            {
              "weight": 1,
              "effects": {
                "toast": "The smaller one wins with a slipper to the head. Your ₦500 is gone."
              }
            }
          ]
        },
        {
          "type": "setFlag",
          "clear": [
            "betOnFight"
          ],
          "flags": []
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "bigManConvoy": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "A black SUV with tinted windows crawls through the go-slow. The window comes down a little. A ring flashes."
        },
        {
          "type": "choice",
          "text": "Rich man for traffic. Na opportunity... or wahala.",
          "options": [
            {
              "text": "\"Oga at the top! Happy Sunday! Your boy dey hungry!\" (beg)",
              "effects": {
                "setFlag": "beggedConvoy"
              }
            },
            {
              "text": "Salute and step back",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 1
                }
              }
            }
          ]
        },
        {
          "type": "randomEvent",
          "if": "beggedConvoy",
          "outcomes": [
            {
              "weight": 3,
              "effects": {
                "changeStat": {
                  "money": 2000,
                  "notoriety": 1
                },
                "toast": "A ₦2,000 note floats out of the window like a blessing."
              }
            },
            {
              "weight": 2,
              "effects": {
                "changeStat": {
                  "policeHeat": 10
                },
                "setFlag": "authorityTrouble",
                "toast": "\"Do you know who I am?\" He is off-duty Task Force. He writes down your face."
              }
            }
          ]
        },
        {
          "type": "setFlag",
          "flag": "metConvoy",
          "clear": [
            "beggedConvoy"
          ]
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "fuelHike": {
      "beats": [
        {
          "type": "newsBroadcast",
          "source": "Baba Radio's stall — Wahala FM 99.9",
          "headline": "FUEL DON GO UP AGAIN",
          "text": "The Minister of Petroleum Matters explains that the new price is \"a temporary permanent adjustment\". Baba Ticket raises everybody's daily share \"in solidarity\".",
          "effects": {
            "changeStat": {
              "fairFee": 100,
              "quota": 1000
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "biodun",
          "text": "Fuel go up, fee go up, quota go up. Only my salary dey do humble.",
          "if": {
            "notFlags": [
              "biodunEnemy"
            ]
          }
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "levy": {
      "beats": [
        {
          "type": "newsBroadcast",
          "source": "Baba Radio's stall — Wahala FM 99.9",
          "headline": "NEW SANITATION LEVY",
          "text": "Local government introduces a \"Sanitation, Beautification and Miscellaneous Levy\" for all street workers. Collectors will wear vests. The vests will also be levied."
        },
        {
          "type": "choice",
          "speaker": "narrator",
          "text": "A man in a brand-new vest holds out a receipt book.",
          "options": [
            {
              "text": "Pay the levy",
              "cost": 2000,
              "effects": {
                "setFlag": "paidLevy",
                "changeStat": {
                  "policeHeat": -3
                }
              }
            },
            {
              "text": "\"Which law? Show me the gazette!\"",
              "effects": {
                "changeStat": {
                  "policeHeat": 4,
                  "notoriety": 2,
                  "communityGoodwill": 2
                }
              }
            }
          ]
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "phoneSnatch": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "A boy on an okada snatches a phone from a woman at the bus stop and zooms off. \"THIEF! THIEF!\" Everybody looks at the fastest person nearby. That's you."
        },
        {
          "type": "choice",
          "speaker": "player",
          "text": "(The okada is weaving through traffic.)",
          "timeout": 6,
          "timeoutOption": 1,
          "options": [
            {
              "text": "Chase him!",
              "effects": {
                "startMode": "chase",
                "params": {
                  "target": "thief",
                  "kind": "okada",
                  "difficulty": 2,
                  "timeLimit": 30
                },
                "results": {
                  "won": {
                    "changeStat": {
                      "communityGoodwill": 4,
                      "notoriety": 2
                    },
                    "toast": "You grab the phone. The woman hugs you. The thief joins a church the next day."
                  },
                  "lost": {
                    "changeStat": {
                      "energy": -8
                    },
                    "toast": "Gone. The woman sighs: \"Lagos.\""
                  }
                }
              }
            },
            {
              "text": "Let him go. Not today.",
              "effects": {
                "changeStat": {
                  "communityGoodwill": -1
                }
              }
            }
          ]
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "okadaCrash": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "CRASH. An okada and a keke meet in the middle of the road. Nobody is badly hurt, but both riders are shouting and a crowd is gathering to 'help'."
        },
        {
          "type": "choice",
          "speaker": "player",
          "text": "(The crowd is getting hot.)",
          "options": [
            {
              "text": "Calm everybody down and push the bikes off the road.",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 3,
                  "energy": -5
                },
                "toast": "Traffic moves again. A driver throws you ₦200 through his window.",
                "goto": "@resume"
              }
            },
            {
              "text": "Charge both of them 'accident clearance fee' (₦1,000).",
              "effects": {
                "changeStat": {
                  "money": 1000,
                  "communityGoodwill": -3,
                  "notoriety": 2
                },
                "goto": "@resume"
              }
            },
            {
              "text": "Keep walking.",
              "effects": {
                "goto": "@resume"
              }
            }
          ]
        }
      ]
    },
    "lostChild": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "passenger",
          "text": "(a small girl in school uniform, holding a lunch flask, crying) I no know where my mummy dey. She say make I wait for here. Since morning."
        },
        {
          "type": "choice",
          "speaker": "player",
          "text": "(She's maybe six.)",
          "options": [
            {
              "text": "Take her round the market until you find her mother.",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 5,
                  "energy": -8
                },
                "setFlag": "foundLostChild",
                "toast": "Her mother is at Ada's Corner, frantic. She hugs the girl, then you, then the girl again."
              }
            },
            {
              "text": "Take her to Mama Put to wait, and ask around.",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 3
                },
                "toast": "Mama Put feeds her. Her mother arrives an hour later and pays for the food. Mama Put refuses."
              }
            }
          ]
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "bigManCash": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "A convoy slows down. Someone in the third car throws naira notes out of the window. The bus stop becomes a rugby match."
        },
        {
          "type": "choice",
          "speaker": "player",
          "text": "(Money is raining.)",
          "options": [
            {
              "text": "Dive in.",
              "effects": {
                "changeStat": {
                  "money": 1500,
                  "energy": -6,
                  "communityGoodwill": -1
                },
                "toast": "You come out with ₦1,500 and somebody's shoe."
              }
            },
            {
              "text": "Help the old woman who got knocked down.",
              "effects": {
                "changeStat": {
                  "communityGoodwill": 4
                },
                "toast": "She blesses you in three languages. You feel richer than ₦1,500."
              }
            }
          ]
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    },
    "touts": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Two touts from another park stroll into your area and start collecting from YOUR drivers. One of them winks at you."
        },
        {
          "type": "choice",
          "speaker": "player",
          "text": "(Your drivers are watching.)",
          "options": [
            {
              "text": "\"This na my area.\" (fight)",
              "effects": {
                "startMode": "fight",
                "params": {
                  "opponent": "thug",
                  "difficulty": 1
                },
                "results": {
                  "won": {
                    "changeStat": {
                      "notoriety": 4,
                      "chairmanTrust": 2
                    },
                    "toast": "They leave. Your drivers pay you a little faster today."
                  },
                  "lost": {
                    "changeStat": {
                      "money": -1000,
                      "energy": -10
                    },
                    "toast": "They take ₦1,000 and your dignity, in that order."
                  }
                }
              }
            },
            {
              "text": "Report them to Baba Ticket's boys.",
              "effects": {
                "changeStat": {
                  "chairmanTrust": 1
                },
                "toast": "Baba Ticket's boys handle it. You owe them now."
              }
            },
            {
              "text": "Split it with them. Peace.",
              "effects": {
                "changeStat": {
                  "money": 500,
                  "notoriety": -1
                }
              }
            }
          ]
        },
        {
          "type": "goto",
          "scene": "@resume"
        }
      ]
    }
  }
}
