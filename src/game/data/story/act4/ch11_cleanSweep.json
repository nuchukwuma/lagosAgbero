              "betrayedShell"
            ]
          }
        },
        {
          "type": "goto",
          "scene": "betraySettlement"
        }
      ]
    },
    "betrayScatter": {
      "location": "backSide",
      "time": "dusk",
      "positions": {
        "scatter": [
          8,
          -6,
          200
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "scatter",
          "text": "Lagos na round. I tell you. Na me give Bassey your name. And now, na me go collect the rest. Boys!"
        },
        {
          "type": "startMode",
          "mode": "fight",
          "params": {
            "opponent": "scatter",
            "difficulty": 3
          },
          "results": {
            "won": {
              "setFlag": "survivedBetrayal",
              "changeStat": {
                "notoriety": 8
              },
              "goto": "climax"
            },
            "lost": {
              "changeStat": {
                "money": -10000
              },
              "goto": "beaten"
            }
          }
        }
      ]
    },
    "betrayChuks": {
      "location": "backSide",
      "time": "dusk",
      "positions": {
        "chuks": [
          8,
          -6,
          200
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "chuks",
          "text": "Brother. I have a file here called 'Strange'. It got very thick. The Shell has decided you are... surplus to requirements. Nothing personal. Everything procedural."
        },
        {
          "type": "startMode",
          "mode": "fight",
          "params": {
            "opponent": "tortoiseBoy",
            "difficulty": 3
          },
          "results": {
            "won": {
              "setFlag": [
                "survivedBetrayal",
                "leftTortoises"
              ],
              "changeStat": {
                "cultLoyalty": -30,
                "notoriety": 6
              },
              "goto": "climax"
            },
            "lost": {
              "setFlag": "leftTortoises",
              "changeStat": {
                "cultLoyalty": -30,
                "cultMoney": -99999
              },
              "goto": "beaten"
            }
          }
        }
      ]
    },
    "betraySettlement": {
      "location": "backSide",
      "time": "dusk",
      "positions": {
        "settlement": [
          8,
          -6,
          200
        ]
      },
      "beats": [
        {
          "type": "dialogue",
          "speaker": "settlement",
          "text": "Ah. You're alive. That is... inconvenient. I told the Task Force about your savings. Nothing personal. You were becoming a problem that money could not settle."
        },
        {
          "type": "dialogue",
          "speaker": "ada",
          "text": "(arriving, out of breath) Relax. Your savings dey my safe. Task Force no fit open my safe. Even me, I struggle.",
          "effects": {
            "setFlag": "savingsSafe"
          },
          "if": "adaKeepsSavings"
        },
        {
          "type": "changeStat",
          "stats": {
            "hustleMoney": -50000
          },
          "if": {
            "notFlags": [
              "adaKeepsSavings"
            ]
          }
        },
        {
          "type": "dialogue",
          "speaker": "settlement",
          "text": "And these gentlemen are here to make sure you are... quiet on Saturday."
        },
        {
          "type": "startMode",
          "mode": "fight",
          "params": {
            "opponent": "thug",
            "difficulty": 3
          },
          "results": {
            "won": {
              "setFlag": "survivedBetrayal",
              "changeStat": {
                "notoriety": 6,
                "settlementTrust": -50
              },
              "goto": "climax"
            },
            "lost": {
              "changeStat": {
                "energy": -25,
                "settlementTrust": -50
              },
              "goto": "beaten"
            }
          }
        }
      ]
    },
    "beaten": {
      "location": "frontStop",
      "time": "night",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "nurse",
          "text": "You. Again. I have started a file for you. Do you know how thick it is? Thicker than the Tortoises'. Sit."
        },
        {
          "type": "goto",
          "scene": "climax"
        }
      ]
    },
