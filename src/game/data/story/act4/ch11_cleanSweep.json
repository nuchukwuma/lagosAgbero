              "sundayInformant",
              "warnedSunday"
            ]
          }
        },
        {
          "type": "dialogue",
          "speaker": "professor",
          "text": "Tomorrow, election. Whatever you do tomorrow, na you go carry am. Rule number... I don lose count. Sleep.",
