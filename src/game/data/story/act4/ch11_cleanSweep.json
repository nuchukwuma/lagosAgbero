            }
          }
        }
      ]
    },
    "warWon": {
      "location": "underBridge",
      "time": "night",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Lord Laffy sits in a puddle and, for the first time in his life, does not laugh. Under-Bridge goes very quiet. Then somebody somewhere knocks twice."
        },
        {
          "type": "goto",
          "scene": "quietNight"
        }
      ]
    },
    "warLost": {
      "location": "underBridge",
      "time": "night",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "The Hyenas laugh you all the way back to the Shell House. The committee stamps your file \"Pending\"."
        },
        {
