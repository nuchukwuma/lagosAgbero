    "hyenaFinal": {
      "location": "underBridge",
      "time": "night",
      "beats": [
        {
          "type": "dialogue",
          "speaker": "chuks",
          "text": "(on the phone) Number One Shell says: tonight, Under-Bridge. Lord Laffy. End the laughing. Bring the Shell home."
        },
        {
          "type": "startMode",
          "mode": "fight",
          "params": {
