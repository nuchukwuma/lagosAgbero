    "chinweSavings": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "chinwe",
          "text": "Emeka. You're here in the afternoon. You only come in the afternoon when you want something. (She smiles. It's not an accusation. It's knowledge.)"
        },
        {
          "type": "choice",
          "speaker": "chinwe",
          "text": "\"Talk. What do you need?\"",
          "options": [
            {
              "text": "\"Lend me your shop savings. I'll send for you within a year.\"",
              "effects": {
                "changeStat": {
                  "money": 80000,
                  "chinweBond": 4,
                  "conscience": -6
                },
                "setFlag": "tookChinweSavings",
                "remember": {
                  "chinweLoan": "promised"
                }
              }
            },
            {
              "text": "\"Lend me. I'll pay it back double.\"",
              "effects": {
                "changeStat": {
                  "money": 80000,
                  "conscience": -10
                },
                "setFlag": "tookChinweSavings",
                "remember": {
                  "chinweLoan": "double"
                }
              }
            },
            {
              "text": "\"Nothing. I came to see you. Forget it.\"",
              "effects": {
                "changeStat": {
                  "chinweBond": 8,
                  "conscience": 5
                },
                "remember": {
                  "chinweLoan": "refused"
                }
              }
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "chinwe",
          "text": "(She brings the money in a Bournvita tin.) Every naira here is a wrapper I sold in the sun. Don't make me regret the sun.",
          "if": "tookChinweSavings"
        },
        {
          "type": "dialogue",
          "speaker": "chinwe",
          "text": "(She looks at you for a long time.) Whatever it is, Emeka... don't do something you can't undo.",
          "if": "!tookChinweSavings"
        },
        {
          "type": "goto",
          "scene": "enough"
        }
      ],
      "location": "chinweHouse",
      "time": "day"
    },
