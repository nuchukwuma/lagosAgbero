{
  "id": "g5_abundance",
  "campaign": "grace",
  "world": "iyanaWahala",
  "act": 1,
  "number": 5,
  "title": "Chapter 5 — Abundance",
  "description": "What the money buys, what the price takes, and who Emeka becomes when Ike comes knocking at 3 a.m.",
  "startScene": "start",
  "scenes": {
    "start": {
      "beats": [
        {
          "type": "setFlag",
          "flags": [
            "ikeAround"
          ]
        },
        {
          "type": "goto",
          "scene": "rich",
          "if": {
            "anyOf": [
              "pact",
              "trickedBook"
            ]
          }
        },
        {
          "type": "goto",
          "scene": "hard"
        }
      ],
      "location": "backSide",
      "time": "dawn"
    },
    "rich": {
      "beats": [
        {
          "type": "cutscene",
          "cards": [
            {
              "title": "Abundance",
              "text": "Contracts arrive that you never bid for. A Benz arrives that you never ordered. A house in Zone 5 opens its gate for you as if it knew you were coming."
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "nneEmeka",
          "text": "(on the phone) My... my... (She stops. Starts again.) My son. I keep trying to say your name. It won't come. Is something wrong with me?",
          "if": {
            "flags": [
              "pact"
            ],
            "memory": {
              "lie_loved": "mother"
            }
          },
          "effects": {
            "changeStat": {
              "motherBond": -10,
              "conscience": -6
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "nneEmeka",
          "text": "(on the phone) E... Emeka. (She says it slowly, like a word in a foreign language.) Strange. Your name feels heavy today.",
          "if": {
            "flags": [
              "trickedBook"
            ],
            "memory": {
              "lie_loved": "mother"
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "chinwe",
          "text": "(on a video call, polite and puzzled) Good evening. Who is this, please?",
          "if": {
            "flags": [
              "pact"
            ],
            "memory": {
              "lie_loved": "chinwe"
            }
          },
          "effects": {
            "changeStat": {
              "chinweBond": -20
            },
            "setFlag": "chinweForgot"
          }
        },
        {
          "type": "dialogue",
          "speaker": "chinwe",
          "text": "(on a video call) Emeka? Your face looks... blurry on my screen. Bad network?",
          "if": {
            "flags": [
              "trickedBook"
            ],
            "memory": {
              "lie_loved": "chinwe"
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "In the mirror of your new bathroom, your reflection moves half a second after you. You stop using mirrors.",
          "if": {
            "flags": [
              "pact"
            ],
            "memory": {
              "lie_loved": "nobody"
            }
          },
          "effects": {
            "setFlag": "reflectionLate",
            "changeStat": {
              "conscience": -8
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Some nights you can't remember Papa's face. Only his name, which you gave away.",
          "if": {
            "flags": [
              "trickedBook"
            ],
            "memory": {
              "lie_loved": "nobody"
            }
          }
        },
        {
          "type": "goto",
          "scene": "spend"
        }
      ],
      "location": "richStreet",
      "time": "day"
    },
    "spend": {
      "beats": [
        {
          "type": "choice",
          "speaker": "player",
          "text": "(You have {money}. It doesn't feel like yours. Maybe it isn't.)",
          "options": [
            {
              "text": "Build Nne a proper house in Nkwọ-Agụụ.",
              "effects": {
                "setFlag": "builtHouse",
                "changeStat": {
                  "motherBond": 10,
                  "hold": 3
                },
                "goto": "spend"
              },
              "cost": 300000,
              "requires": {
                "notFlags": [
                  "builtHouse"
                ]
              }
            },
            {
              "text": "Pay back the harvest money, every naira.",
              "effects": {
                "setFlag": "repaidVillage",
                "payDebt": {
                  "from": "money",
                  "to": "villageDebt"
                },
                "changeStat": {
                  "villageStanding": 15,
                  "conscience": 6
                },
                "goto": "spend"
              },
              "requires": {
                "flags": [
                  "tookHarvest"
                ],
                "notFlags": [
                  "repaidVillage"
                ]
              }
            },
            {
              "text": "Buy back Papa's land.",
              "effects": {
                "setFlag": "boughtLandBack",
                "changeStat": {
                  "conscience": 6,
                  "motherBond": 6
                },
                "goto": "spend"
              },
              "cost": 250000,
              "requires": {
                "flags": [
                  "soldLand"
                ],
                "notFlags": [
                  "boughtLandBack"
                ]
              }
            },
            {
              "text": "Send Chinwe her savings back, with interest.",
              "effects": {
                "setFlag": "repaidChinwe",
                "changeStat": {
                  "chinweBond": 10
                },
                "goto": "spend"
              },
              "cost": 160000,
              "requires": {
                "flags": [
                  "tookChinweSavings"
                ],
                "notFlags": [
                  "repaidChinwe"
                ]
              }
            },
            {
              "text": "Keep it. Lagos first.",
              "effects": {
                "setFlag": "hoarded",
                "changeStat": {
                  "hold": 10
                },
                "goto": "bassey"
              }
            },
            {
              "text": "That's enough giving.",
              "effects": {
                "remember": {
                  "gave": "some"
                },
                "goto": "bassey"
              }
            }
          ]
        }
      ],
      "location": "richStreet"
    },
    "hard": {
      "beats": [
        {
          "type": "cutscene",
          "cards": [
            {
              "title": "The hard road",
              "text": "The Fellowship doesn't burn you. It just... closes doors. Customers vanish. Landlords remember they have nephews. Your name stops working in shops where it worked last week."
            }
          ]
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "You were beaten at that gate. Your ribs still tell the weather.",
          "if": "beatenByUshers"
        },
        {
          "type": "dialogue",
          "speaker": "biodun",
          "text": "You need work? My danfo needs a second driver. 'God's Time Is The Best.' Fuel money is yours, the bus is mine, the passengers are God's."
        },
        {
          "type": "startMode",
          "mode": "drive",
          "params": {
            "length": 2000,
            "stops": 4,
            "fuel": 55,
            "checkpoints": 1,
            "slogan": "GOD'S TIME IS THE BEST",
            "seed": 57
          },
          "results": {
            "done": {
              "changeStat": {
                "conscience": 4
              },
              "remember": {
                "grind": "drove"
              },
              "goto": "chinwe"
            },
            "default": {
              "changeStat": {
                "energy": -10
              },
              "remember": {
                "grind": "struggled"
              },
              "goto": "chinwe"
            }
          }
        }
      ],
      "location": "frontStop",
      "time": "day",
      "positions": {
        "biodun": [
          -24.5,
          -4.6,
          0
        ]
      }
    },
    "chinwe": {
      "beats": [
        {
          "type": "goto",
          "scene": "chinweComes",
          "if": {
            "memory": {
              "chinwePromise": "sendFor"
            },
            "stats": {
              "chinweBond": ">= 50"
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "Chinwe's last message was a week ago. You keep reading it. 'I'm still counting.'",
          "if": {
            "memory": {
              "chinwePromise": "oneYear"
            }
          }
        },
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "You told Chinwe not to wait. Some nights you wish she hadn't listened.",
          "if": {
            "memory": {
              "chinwePromise": "dontWait"
            }
          }
        },
        {
          "type": "goto",
          "scene": "bassey"
        }
      ],
      "location": "backSide",
      "time": "dusk"
    },
    "chinweComes": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "chinwe",
          "text": "(at the Back Side, holding one bag) You said you would send for me. You didn't. So I sent for myself."
        },
        {
          "type": "choice",
          "speaker": "chinwe",
          "text": "\"Well? Say something before I change my mind.\"",
          "options": [
            {
              "text": "\"Marry me. Here. With nothing.\"",
              "effects": {
                "setFlag": [
                  "chinweInLagos",
                  "married"
                ],
                "changeStat": {
                  "chinweBond": 15,
                  "conscience": 6
                }
              }
            },
            {
              "text": "\"Stay. But not yet. Let me fix things first.\"",
              "effects": {
                "setFlag": "chinweInLagos",
                "changeStat": {
                  "chinweBond": 4
                }
              }
            }
          ]
        },
        {
          "type": "goto",
          "scene": "bassey"
        }
      ],
      "location": "backSide",
      "time": "dusk",
      "positions": {
        "chinwe": [
          6,
          -5,
          200
        ]
      }
    },
    "bassey": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "bassey",
          "text": "{name}. Sit. I remember your face from that box of fake customs papers. You've come up in the world.",
          "if": "packageCaught"
        },
        {
          "type": "dialogue",
          "speaker": "bassey",
          "text": "{name}. Sit. Your name keeps appearing near another name. Chief Ọ̀dụ̀. I have been following that name for six years."
        },
        {
          "type": "choice",
          "speaker": "bassey",
          "text": "(He waits. He is very good at waiting.)",
          "options": [
            {
              "text": "Show him the photos of the white book.",
              "effects": {
                "setFlag": "toldBassey",
                "changeStat": {
                  "hold": -10,
                  "policeHeat": -10
                },
                "goto": "basseyDeal"
              },
              "requires": "bookPhoto",
              "showLocked": true,
              "lockedText": "You'd need evidence"
            },
            {
              "text": "Answer his questions. Carefully.",
              "effects": {
                "remember": {
                  "basseyTalk": "answered"
                },
                "goto": "basseyQuestions"
              }
            }
          ]
        }
      ],
      "location": "frontStop",
      "time": "day",
      "positions": {
        "bassey": [
          -12,
          -6,
          180
        ]
      }
    },
    "basseyQuestions": {
      "beats": [
        {
          "type": "startMode",
          "mode": "bluff",
          "params": {
            "scenario": "policeLagos"
          },
          "results": {
            "confessed": {
              "setFlag": "toldBassey",
