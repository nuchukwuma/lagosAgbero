            },
            "default": {
              "changeStat": {
                "policeHeat": -5
              },
              "goto": "ikeCrisis"
            }
          }
        }
      ],
      "location": "frontStop",
      "positions": {
        "bassey": [
          -12,
          -6,
          180
        ]
      }
    },
    "basseyDeal": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "bassey",
          "text": "(He looks at the evidence for a long time.) Six years. Six years and a village boy brings it to me. When I move, I will need you to stand up in court. Can you stand?"
        },
        {
          "type": "goto",
          "scene": "ikeCrisis"
        }
      ],
      "location": "frontStop",
      "positions": {
        "bassey": [
          -12,
          -6,
          180
        ]
      }
    },
    "ikeCrisis": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "ike",
          "text": "(at your door, 3 a.m., shaking) They want a second price. My mother. Not her life, they said. Her mind. I said no. Emeka, I said no. They are coming."
        },
        {
          "type": "dialogue",
          "speaker": "ike",
          "text": "You told me to leave them. I'm leaving. Help me.",
          "if": {
            "memory": {
              "ikeSecret": "warned"
            }
          }
        },
        {
          "type": "choice",
          "speaker": "ike",
          "text": "(Headlights at the end of the street. White cars.)",
          "options": [
            {
              "text": "\"Get behind me.\" Fight whoever comes.",
              "effects": {
                "goto": "ikeFight"
              }
            },
            {
              "text": "Call the Chief. Tell him where Ike is.",
              "effects": {
                "setFlag": [
                  "betrayedIke",
                  "ikeLost"
                ],
                "changeStat": {
                  "hold": 15,
                  "chiefFavour": 15,
                  "conscience": -20,
                  "ikeTrust": -50
                },
                "goto": "summons"
              },
              "requires": {
                "anyOf": [
                  "pact",
                  "trickedBook"
                ]
              }
            },
            {
              "text": "\"I can't help you, Ike. I'm sorry.\"",
              "effects": {
                "setFlag": "ikeLost",
                "changeStat": {
                  "conscience": -6,
                  "ikeTrust": -20
                },
                "goto": "summons"
              }
            }
          ]
        }
      ],
      "location": "backSide",
      "time": "night",
      "positions": {
        "ike": [
          7,
          -6,
          200
        ]
      }
    },
    "ikeFight": {
      "beats": [
        {
          "type": "startMode",
          "mode": "fight",
          "params": {
            "opponent": "usher",
            "difficulty": 2
          },
          "results": {
            "won": {
              "setFlag": "savedIke",
              "changeStat": {
                "ikeTrust": 30,
                "conscience": 8,
                "hold": -5
              },
              "goto": "ikeSaved"
            },
            "lost": {
              "setFlag": "ikeLost",
              "changeStat": {
                "energy": -25
              },
              "goto": "ikeTaken"
            }
          }
        }
      ],
      "location": "backSide",
      "time": "night"
    },
    "ikeSaved": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "ike",
          "text": "(on the back of an okada, Formula One driving like the devil owes him money) I don't know where I'm going. But I'm going. Thank you, Emeka. (And for one second, almost, he laughs.)"
        },
        {
          "type": "goto",
          "scene": "summons"
        }
      ],
      "location": "backSide",
      "time": "night"
    },
    "ikeTaken": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "narrator",
          "text": "They take Ike gently, like porters lifting a box. He doesn't fight. He looks at you once. It isn't blame. That's worse."
        },
        {
          "type": "goto",
          "scene": "summons"
        }
      ],
      "location": "backSide",
      "time": "night"
    },
    "summons": {
      "beats": [
        {
          "type": "dialogue",
          "speaker": "onyisi",
          "text": "(a call from the village) {name}. The New Yam festival is in three days. Your mother is not well. And the village has questions. Come home and answer them like a man."
        },
        {
          "type": "endChapter",
          "title": "End of Chapter 5 — Abundance",
          "summary": "Money {money}. Conscience {stat:conscience}. The Fellowship's hold {stat:hold}. Nkwọ-Agụụ is calling you home.",
          "next": "g6_grace"
        }
      ],
      "location": "backSide",
      "time": "dawn"
    }
  }
